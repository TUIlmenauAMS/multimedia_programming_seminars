# =============================================================================
# .gitignore — Multimediaprogrammierung Seminars
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── uv / virtual environment ──────────────────────────────────────────────────
.venv
.python-version

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ── Ruff ──────────────────────────────────────────────────────────────────────
.ruff_cache/

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Type checkers ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ── Distribution / build (not publishing, but just in case) ──────────────────
dist/
build/
*.egg-info/
*.egg

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/
