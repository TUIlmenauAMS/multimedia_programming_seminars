{
  "name": "WebRTC Seminar 04",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Install Python 3.12 via the devcontainers feature registry.
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },

  // postCreateCommand runs once after the container is created.
  // Uses sudo for system-level operations (apt-get, mkdir under /etc/, /var/).
  // The vscode user has passwordless sudo in devcontainer base images.
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y coturn && pip install websockets --break-system-packages && sudo mkdir -p /etc/coturn /var/log/coturn && sudo chmod 777 /etc/coturn /var/log/coturn",

  // postStartCommand runs every time the Codespace starts (including after resume).
  "postStartCommand": "bash codespace/start.sh",

  "forwardPorts": [8765, 5349],
  "portsAttributes": {
    "8765": { "label": "Signaling Server (WSS)", "protocol": "https" },
    "5349": { "label": "TURN Server (TURNS/TCP)", "protocol": "https" }
  },

  "remoteUser": "vscode"
}
